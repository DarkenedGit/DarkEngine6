{
  "version": 1,
  "model": "models/wolf.gltf",
  "defaultState": "Idle",
  "parameters": [
    { "name": "speed", "type": "float", "default": 0.0 },
    { "name": "swing", "type": "trigger" },
    { "name": "bite", "type": "trigger" },
    { "name": "jump_attack", "type": "trigger" },
    { "name": "dead", "type": "bool", "default": false }
  ],
  "states": [
    { "name": "Idle", "clip": "Idle", "loop": true },
    { "name": "Walk", "clip": "Walk", "loop": true },
    { "name": "Run", "clip": "Run", "loop": true },
    { "name": "Bite", "clip": "Bite", "loop": false },
    { "name": "Jump", "clip": "Jump", "loop": false },
    { "name": "Die", "clip": "Die", "loop": false }
  ],
  "transitions": [
    { "from": "Idle", "to": "Die", "blend": 0.10, "interrupt": true,
      "when": [{ "param": "dead", "eq": true }] },
    { "from": "Walk", "to": "Die", "blend": 0.10, "interrupt": true,
      "when": [{ "param": "dead", "eq": true }] },
    { "from": "Run", "to": "Die", "blend": 0.10, "interrupt": true,
      "when": [{ "param": "dead", "eq": true }] },
    { "from": "Bite", "to": "Die", "blend": 0.08, "interrupt": true,
      "when": [{ "param": "dead", "eq": true }] },
    { "from": "Jump", "to": "Die", "blend": 0.08, "interrupt": true,
      "when": [{ "param": "dead", "eq": true }] },
    { "from": "Die", "to": "Idle", "blend": 0.20, "interrupt": true,
      "when": [{ "param": "dead", "eq": false }] },
    { "from": "Idle", "to": "Jump", "blend": 0.08, "interrupt": true,
      "when": [{ "param": "jump_attack", "eq": true }] },
    { "from": "Walk", "to": "Jump", "blend": 0.08, "interrupt": true,
      "when": [{ "param": "jump_attack", "eq": true }] },
    { "from": "Run", "to": "Jump", "blend": 0.08, "interrupt": true,
      "when": [{ "param": "jump_attack", "eq": true }] },
    { "from": "Bite", "to": "Jump", "blend": 0.08, "interrupt": true,
      "when": [{ "param": "jump_attack", "eq": true }] },
    { "from": "*", "to": "Bite", "blend": 0.08, "interrupt": true,
      "when": [{ "param": "swing", "eq": true }] },
    { "from": "*", "to": "Bite", "blend": 0.08, "interrupt": true,
      "when": [{ "param": "bite", "eq": true }] },
    { "from": "Jump", "to": "Run", "blend": 0.12, "onClipEnd": true,
      "when": [{ "param": "speed", "gt": 8.0 }] },
    { "from": "Jump", "to": "Walk", "blend": 0.12, "onClipEnd": true,
      "when": [{ "param": "speed", "gt": 1.2 }] },
    { "from": "Jump", "to": "Idle", "blend": 0.14, "onClipEnd": true },
    { "from": "Bite", "to": "Run", "blend": 0.10, "onClipEnd": true,
      "when": [{ "param": "speed", "gt": 8.0 }] },
    { "from": "Bite", "to": "Walk", "blend": 0.10, "onClipEnd": true,
      "when": [{ "param": "speed", "gt": 1.2 }] },
    { "from": "Bite", "to": "Idle", "blend": 0.12, "onClipEnd": true },
    { "from": "Idle", "to": "Walk", "blend": 0.15, "interrupt": true,
      "when": [{ "param": "speed", "gt": 1.2 }] },
    { "from": "Walk", "to": "Run", "blend": 0.12, "interrupt": true,
      "when": [{ "param": "speed", "gt": 8.0 }] },
    { "from": "Run", "to": "Walk", "blend": 0.14, "interrupt": true,
      "when": [{ "param": "speed", "lt": 6.5 }] },
    { "from": "Walk", "to": "Idle", "blend": 0.18, "interrupt": true,
      "when": [{ "param": "speed", "lt": 0.8 }] },
    { "from": "Run", "to": "Idle", "blend": 0.16, "interrupt": true,
      "when": [{ "param": "speed", "lt": 0.8 }] }
  ],
  "notifies": [
    { "clip": "Walk", "name": "footstep", "time": 0.20 },
    { "clip": "Walk", "name": "footstep", "time": 0.60 },
    { "clip": "Run", "name": "footstep", "time": 0.11 },
    { "clip": "Run", "name": "footstep", "time": 0.33 },
    { "clip": "Bite", "name": "bite", "time": 0.22 },
    { "clip": "Jump", "name": "jump", "time": 0.14 }
  ]
}
