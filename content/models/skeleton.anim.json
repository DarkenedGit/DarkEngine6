{
  "version": 1,
  "model": "models/skeleton.gltf",
  "defaultState": "Idle",
  "parameters": [
    { "name": "speed", "type": "float", "default": 0.0 },
    { "name": "strafe", "type": "float", "default": 0.0 },
    { "name": "shoot", "type": "trigger" },
    { "name": "swing", "type": "trigger" },
    { "name": "dead", "type": "bool", "default": false }
  ],
  "states": [
    { "name": "Idle", "clip": "Idle", "loop": true },
    { "name": "Walk", "clip": "Walk", "loop": true },
    { "name": "Run", "clip": "Run", "loop": true },
    { "name": "StrafeLeft", "clip": "StrafeLeft", "loop": true },
    { "name": "StrafeRight", "clip": "StrafeRight", "loop": true },
    { "name": "StrafeRunLeft", "clip": "StrafeRunLeft", "loop": true },
    { "name": "StrafeRunRight", "clip": "StrafeRunRight", "loop": true },
    { "name": "Shoot", "clip": "Shoot", "loop": false },
    { "name": "Swing", "clip": "SwingSword", "loop": false },
    { "name": "Die", "clip": "Die", "loop": false }
  ],
  "transitions": [
    { "from": "Idle", "to": "Die", "blend": 0.10, "interrupt": true,
      "when": [{ "param": "dead", "eq": true }] },
    { "from": "Walk", "to": "Die", "blend": 0.10, "interrupt": true,
      "when": [{ "param": "dead", "eq": true }] },
    { "from": "Run", "to": "Die", "blend": 0.10, "interrupt": true,
      "when": [{ "param": "dead", "eq": true }] },
    { "from": "StrafeLeft", "to": "Die", "blend": 0.10, "interrupt": true,
      "when": [{ "param": "dead", "eq": true }] },
    { "from": "StrafeRight", "to": "Die", "blend": 0.10, "interrupt": true,
      "when": [{ "param": "dead", "eq": true }] },
    { "from": "StrafeRunLeft", "to": "Die", "blend": 0.10, "interrupt": true,
      "when": [{ "param": "dead", "eq": true }] },
    { "from": "StrafeRunRight", "to": "Die", "blend": 0.10, "interrupt": true,
      "when": [{ "param": "dead", "eq": true }] },
    { "from": "Shoot", "to": "Die", "blend": 0.08, "interrupt": true,
      "when": [{ "param": "dead", "eq": true }] },
    { "from": "Swing", "to": "Die", "blend": 0.08, "interrupt": true,
      "when": [{ "param": "dead", "eq": true }] },
    { "from": "Die", "to": "Idle", "blend": 0.20, "interrupt": true,
      "when": [{ "param": "dead", "eq": false }] },
    { "from": "*", "to": "Shoot", "blend": 0.08, "interrupt": true,
      "when": [{ "param": "shoot", "eq": true }] },
    { "from": "*", "to": "Swing", "blend": 0.08, "interrupt": true,
      "when": [{ "param": "swing", "eq": true }] },
    { "from": "Shoot", "to": "StrafeRunRight", "blend": 0.10, "onClipEnd": true,
      "when": [{ "param": "strafe", "gt": 11.0 }] },
    { "from": "Shoot", "to": "StrafeRunLeft", "blend": 0.10, "onClipEnd": true,
      "when": [{ "param": "strafe", "lt": -11.0 }] },
    { "from": "Shoot", "to": "StrafeRight", "blend": 0.10, "onClipEnd": true,
      "when": [{ "param": "strafe", "gt": 1.2 }] },
    { "from": "Shoot", "to": "StrafeLeft", "blend": 0.10, "onClipEnd": true,
      "when": [{ "param": "strafe", "lt": -1.2 }] },
    { "from": "Shoot", "to": "Run", "blend": 0.10, "onClipEnd": true,
      "when": [{ "param": "speed", "gt": 5.0 }] },
    { "from": "Shoot", "to": "Walk", "blend": 0.10, "onClipEnd": true,
      "when": [{ "param": "speed", "gt": 1.2 }] },
    { "from": "Shoot", "to": "Idle", "blend": 0.12, "onClipEnd": true },
    { "from": "Swing", "to": "StrafeRunRight", "blend": 0.10, "onClipEnd": true,
      "when": [{ "param": "strafe", "gt": 11.0 }] },
    { "from": "Swing", "to": "StrafeRunLeft", "blend": 0.10, "onClipEnd": true,
      "when": [{ "param": "strafe", "lt": -11.0 }] },
    { "from": "Swing", "to": "StrafeRight", "blend": 0.10, "onClipEnd": true,
      "when": [{ "param": "strafe", "gt": 1.2 }] },
    { "from": "Swing", "to": "StrafeLeft", "blend": 0.10, "onClipEnd": true,
      "when": [{ "param": "strafe", "lt": -1.2 }] },
    { "from": "Swing", "to": "Run", "blend": 0.10, "onClipEnd": true,
      "when": [{ "param": "speed", "gt": 11.0 }] },
    { "from": "Swing", "to": "Walk", "blend": 0.10, "onClipEnd": true,
      "when": [{ "param": "speed", "gt": 1.2 }] },
    { "from": "Swing", "to": "Idle", "blend": 0.12, "onClipEnd": true },
    { "from": "Idle", "to": "StrafeRight", "blend": 0.15, "interrupt": true,
      "when": [{ "param": "strafe", "gt": 1.2 }] },
    { "from": "Idle", "to": "StrafeLeft", "blend": 0.15, "interrupt": true,
      "when": [{ "param": "strafe", "lt": -1.2 }] },
    { "from": "Idle", "to": "Walk", "blend": 0.15, "interrupt": true,
      "when": [{ "param": "speed", "gt": 1.2 }] },
    { "from": "Walk", "to": "StrafeRunRight", "blend": 0.12, "interrupt": true,
      "when": [{ "param": "strafe", "gt": 11.0 }] },
    { "from": "Walk", "to": "StrafeRunLeft", "blend": 0.12, "interrupt": true,
      "when": [{ "param": "strafe", "lt": -11.0 }] },
    { "from": "Walk", "to": "StrafeRight", "blend": 0.12, "interrupt": true,
      "when": [{ "param": "strafe", "gt": 1.2 }] },
    { "from": "Walk", "to": "StrafeLeft", "blend": 0.12, "interrupt": true,
      "when": [{ "param": "strafe", "lt": -1.2 }] },
    { "from": "Walk", "to": "Run", "blend": 0.12, "interrupt": true,
      "when": [{ "param": "speed", "gt": 11.0 }] },
    { "from": "Walk", "to": "Idle", "blend": 0.18, "interrupt": true,
      "when": [{ "param": "speed", "lt": 0.8 }] },
    { "from": "Run", "to": "StrafeRunRight", "blend": 0.12, "interrupt": true,
      "when": [{ "param": "strafe", "gt": 11.0 }] },
    { "from": "Run", "to": "StrafeRunLeft", "blend": 0.12, "interrupt": true,
      "when": [{ "param": "strafe", "lt": -11.0 }] },
    { "from": "Run", "to": "StrafeRight", "blend": 0.12, "interrupt": true,
      "when": [{ "param": "strafe", "gt": 1.2 }] },
    { "from": "Run", "to": "StrafeLeft", "blend": 0.12, "interrupt": true,
      "when": [{ "param": "strafe", "lt": -1.2 }] },
    { "from": "Run", "to": "Walk", "blend": 0.14, "interrupt": true,
      "when": [{ "param": "speed", "lt": 9.5 }] },
    { "from": "Run", "to": "Idle", "blend": 0.16, "interrupt": true,
      "when": [{ "param": "speed", "lt": 0.8 }] },
    { "from": "StrafeRight", "to": "StrafeRunRight", "blend": 0.12, "interrupt": true,
      "when": [{ "param": "strafe", "gt": 11.0 }] },
    { "from": "StrafeRight", "to": "StrafeRunLeft", "blend": 0.12, "interrupt": true,
      "when": [{ "param": "strafe", "lt": -11.0 }] },
    { "from": "StrafeRight", "to": "StrafeLeft", "blend": 0.12, "interrupt": true,
      "when": [{ "param": "strafe", "lt": -1.2 }] },
    { "from": "StrafeRight", "to": "Run", "blend": 0.12, "interrupt": true,
      "when": [{ "param": "speed", "gt": 11.0 }, { "param": "strafe", "lt": 0.8 }] },
    { "from": "StrafeRight", "to": "Walk", "blend": 0.14, "interrupt": true,
      "when": [{ "param": "speed", "gt": 1.2 }, { "param": "strafe", "lt": 0.8 }] },
    { "from": "StrafeRight", "to": "Idle", "blend": 0.18, "interrupt": true,
      "when": [{ "param": "speed", "lt": 0.8 }] },
    { "from": "StrafeLeft", "to": "StrafeRunLeft", "blend": 0.12, "interrupt": true,
      "when": [{ "param": "strafe", "lt": -11.0 }] },
    { "from": "StrafeLeft", "to": "StrafeRunRight", "blend": 0.12, "interrupt": true,
      "when": [{ "param": "strafe", "gt": 11.0 }] },
    { "from": "StrafeLeft", "to": "StrafeRight", "blend": 0.12, "interrupt": true,
      "when": [{ "param": "strafe", "gt": 1.2 }] },
    { "from": "StrafeLeft", "to": "Run", "blend": 0.12, "interrupt": true,
      "when": [{ "param": "speed", "gt": 11.0 }, { "param": "strafe", "gt": -0.8 }] },
    { "from": "StrafeLeft", "to": "Walk", "blend": 0.14, "interrupt": true,
      "when": [{ "param": "speed", "gt": 1.2 }, { "param": "strafe", "gt": -0.8 }] },
    { "from": "StrafeLeft", "to": "Idle", "blend": 0.18, "interrupt": true,
      "when": [{ "param": "speed", "lt": 0.8 }] },
    { "from": "StrafeRunRight", "to": "StrafeRunLeft", "blend": 0.12, "interrupt": true,
      "when": [{ "param": "strafe", "lt": -11.0 }] },
    { "from": "StrafeRunRight", "to": "StrafeLeft", "blend": 0.12, "interrupt": true,
      "when": [{ "param": "strafe", "lt": -1.2 }] },
    { "from": "StrafeRunRight", "to": "StrafeRight", "blend": 0.14, "interrupt": true,
      "when": [{ "param": "strafe", "lt": 9.5 }, { "param": "strafe", "gt": 0.8 }] },
    { "from": "StrafeRunRight", "to": "Run", "blend": 0.14, "interrupt": true,
      "when": [{ "param": "speed", "gt": 9.5 }, { "param": "strafe", "lt": 0.8 }, { "param": "strafe", "gt": -0.8 }] },
    { "from": "StrafeRunRight", "to": "Walk", "blend": 0.14, "interrupt": true,
      "when": [{ "param": "speed", "gt": 1.2 }, { "param": "strafe", "lt": 0.8 }, { "param": "strafe", "gt": -0.8 }] },
    { "from": "StrafeRunRight", "to": "Idle", "blend": 0.16, "interrupt": true,
      "when": [{ "param": "speed", "lt": 0.8 }] },
    { "from": "StrafeRunLeft", "to": "StrafeRunRight", "blend": 0.12, "interrupt": true,
      "when": [{ "param": "strafe", "gt": 11.0 }] },
    { "from": "StrafeRunLeft", "to": "StrafeRight", "blend": 0.12, "interrupt": true,
      "when": [{ "param": "strafe", "gt": 1.2 }] },
    { "from": "StrafeRunLeft", "to": "StrafeLeft", "blend": 0.14, "interrupt": true,
      "when": [{ "param": "strafe", "gt": -9.5 }, { "param": "strafe", "lt": -0.8 }] },
    { "from": "StrafeRunLeft", "to": "Run", "blend": 0.14, "interrupt": true,
      "when": [{ "param": "speed", "gt": 9.5 }, { "param": "strafe", "gt": -0.8 }, { "param": "strafe", "lt": 0.8 }] },
    { "from": "StrafeRunLeft", "to": "Walk", "blend": 0.14, "interrupt": true,
      "when": [{ "param": "speed", "gt": 1.2 }, { "param": "strafe", "gt": -0.8 }, { "param": "strafe", "lt": 0.8 }] },
    { "from": "StrafeRunLeft", "to": "Idle", "blend": 0.16, "interrupt": true,
      "when": [{ "param": "speed", "lt": 0.8 }] }
  ]
}
