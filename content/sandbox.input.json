{
  "version": 1,
  "type": "sandbox",
  "note": "Sandbox app commands. Player move, look, combat, camouflage, and pickup stay in entities/player.entity.input.json, which loads after this file. scale -1 reverses a key, button, or stick.",
  "bindings": [
    { "action": "quit", "key": "Escape" },
    { "action": "quit", "button": "Back" },
    { "action": "pause", "key": "F3" },
    { "action": "pause", "button": "Start" },
    { "action": "step", "key": "O" },
    { "action": "quick_save", "key": "F5" },
    { "action": "quick_load", "key": "F9" },
    { "action": "toggle_lighting", "key": "F2" },
    { "action": "reset", "key": "R" },
    { "action": "reset", "button": "Y" },
    { "action": "speed_up", "key": "Equal" },
    { "action": "speed_up", "button": "RightShoulder" },
    { "action": "speed_down", "key": "Minus" },
    { "action": "speed_down", "button": "X" },

    { "action": "yaw", "key": "Q", "scale": -1 },
    { "action": "yaw", "key": "E", "scale": 1 },
    { "action": "pitch", "key": "Z", "scale": 1 },
    { "action": "pitch", "key": "X", "scale": -1 },

    { "action": "pawn_x", "key": "Left", "scale": -1 },
    { "action": "pawn_x", "key": "Right", "scale": 1 },
    { "action": "pawn_x", "button": "DPadLeft", "scale": -1 },
    { "action": "pawn_x", "button": "DPadRight", "scale": 1 },
    { "action": "pawn_z", "key": "Up", "scale": 1 },
    { "action": "pawn_z", "key": "Down", "scale": -1 },
    { "action": "pawn_z", "button": "DPadUp", "scale": 1 },
    { "action": "pawn_z", "button": "DPadDown", "scale": -1 },

    { "action": "fly_forward", "key": "W", "scale": 1 },
    { "action": "fly_forward", "key": "S", "scale": -1 },
    { "action": "fly_forward", "axis": "LeftY", "scale": 1 },
    { "action": "fly_strafe", "key": "A", "scale": -1 },
    { "action": "fly_strafe", "key": "D", "scale": 1 },
    { "action": "fly_strafe", "axis": "LeftX", "scale": 1 },
    { "action": "fly_climb", "key": "Q", "scale": 1 },
    { "action": "fly_climb", "key": "Space", "scale": 1 },
    { "action": "fly_climb", "key": "Z", "scale": -1 },
    { "action": "fly_climb", "key": "LeftControl", "scale": -1 },
    { "action": "fly_climb", "axis": "RightTrigger", "scale": 1 },
    { "action": "fly_climb", "axis": "LeftTrigger", "scale": -1 },

    { "action": "dev_tools", "key": "M" },
    { "action": "profiler", "key": "P" },
    { "action": "inventory", "key": "I" },
    { "action": "anim_walk", "key": "T" },
    { "action": "anim_walk", "button": "RightThumb" }
  ]
}
