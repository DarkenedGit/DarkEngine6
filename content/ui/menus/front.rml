<rml>
<head>
<title>CRISPER</title>
<style>
body {
	width: 100%;
	height: 100%;
	margin: 0px;
	padding: 0px;
	font-family: Roboto;
	font-weight: normal;
	color: #f4f6f8;
	background-color: #060a10;
}
#bg {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 100%;
	height: 100%;
	background-color: #060a10;
	decorator: image("../menu/crisper_bg.jpg" cover);
	pointer-events: none;
}
#scrim {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 46%;
	height: 100%;
	background-color: #04070c;
	opacity: 0.72;
	pointer-events: none;
}
#stage {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 100%;
	height: 100%;
	opacity: 0;
	transform: translateY(-24dp);
	transition: opacity transform 0.2s cubic-out;
	pointer-events: none;
}
#stage.open {
	opacity: 1;
	transform: translateY(0dp);
}
#panel {
	position: absolute;
	left: 5.5%;
	top: 14%;
	width: 36%;
	pointer-events: auto;
}
h1 {
	margin: 0px;
	font-size: 84dp;
	letter-spacing: 6dp;
	font-weight: normal;
	color: #f4f6f8;
}
#actions {
	margin-top: 28dp;
}
button.row {
	display: block;
	width: 100%;
	margin: 0px;
	margin-top: 8dp;
	padding: 4dp 12dp;
	background-color: transparent;
	color: #f4f6f8;
	border-width: 0px;
	font-size: 32dp;
	font-weight: normal;
	letter-spacing: 3dp;
	text-align: left;
	white-space: nowrap;
	tab-index: auto;
	nav: auto;
	pointer-events: auto;
	transition: background-color color 0.15s cubic-out;
}
button.row:hover,
button.row:focus-visible {
	color: #9ceee8;
	background-color: #12363a;
}
.sub {
	margin-top: 2dp;
	font-size: 13dp;
	letter-spacing: 1dp;
	color: #a8b2bc;
}
#levels {
	position: absolute;
	right: 4%;
	top: 18%;
	width: 24%;
	pointer-events: auto;
}
#levels.hidden {
	display: none;
}
.kicker {
	font-size: 12dp;
	letter-spacing: 2dp;
	color: #8c9ca8;
}
.head {
	margin-top: 4dp;
	margin-bottom: 10dp;
	font-size: 16dp;
	letter-spacing: 2dp;
	color: #bac6d0;
}
#level-list {
	max-height: 520dp;
	overflow-y: auto;
	/* This box is hit before its rows. Leave the rows as the mouse target. */
	pointer-events: none;
}
button.level {
	width: auto;
	font-size: 15dp;
	letter-spacing: 1dp;
	margin-top: 2dp;
	padding-top: 5dp;
	padding-bottom: 5dp;
}
#status {
	display: none;
	position: absolute;
	left: 5.5%;
	bottom: 6%;
	font-size: 16dp;
	letter-spacing: 2dp;
	color: #96ece6;
	pointer-events: none;
}
#status.on {
	display: block;
}
#status-name {
	color: #f4f6f8;
	margin-bottom: 4dp;
}
body.loading button.row {
	color: #7f8a94;
}
body.loading button.row:focus-visible {
	color: #9ceee8;
}
</style>
</head>
<body>
<div id="bg"></div>
<div id="scrim"></div>
<div id="stage">
	<div id="panel">
		<h1 id="title">CRISPER</h1>
		<div id="actions"></div>
	</div>
	<div id="levels">
		<div class="kicker">DEBUG</div>
		<div class="head">JUMP TO LEVEL</div>
		<div id="level-list"></div>
	</div>
	<div id="status">
		<div id="status-name"></div>
		<div id="status-word">LOADING</div>
	</div>
</div>
</body>
</rml>
