<rml>
<head>
<title>PAUSED</title>
<style>
body {
	width: 100%;
	height: 100%;
	margin: 0px;
	padding: 0px;
	font-family: Roboto;
	font-weight: normal;
	color: #f4f6f8;
	background-color: transparent;
	pointer-events: none;
}
#dim {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 100%;
	height: 100%;
	background-color: #000000;
	opacity: 0.45;
	pointer-events: none;
}
#stage {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 100%;
	height: 100%;
	opacity: 0;
	transform: translateY(-24dp);
	transition: opacity transform 0.2s cubic-out;
	pointer-events: none;
}
#stage.open {
	opacity: 1;
	transform: translateY(0dp);
}
#card {
	position: absolute;
	left: 50%;
	top: 38%;
	width: 680dp;
	margin-left: -340dp;
	padding: 28dp 32dp;
	background-color: #0c1218;
	border-width: 1dp;
	border-color: #1c3c40;
	pointer-events: none;
}
h1 {
	margin: 0px;
	font-size: 36dp;
	letter-spacing: 4dp;
	font-weight: normal;
	color: #f4f6f8;
	pointer-events: none;
}
.hint {
	margin-top: 14dp;
	font-size: 15dp;
	letter-spacing: 0.5dp;
	color: #e6eaee;
	white-space: normal;
	pointer-events: none;
}
.hint.quiet {
	margin-top: 6dp;
	color: #8c9ca8;
}
button.row {
	display: block;
	box-sizing: border-box;
	width: 100%;
	margin: 0px;
	margin-top: 12dp;
	padding: 6dp 12dp;
	background-color: transparent;
	color: #f4f6f8;
	border-width: 0px;
	font-size: 22dp;
	font-weight: normal;
	letter-spacing: 3dp;
	text-align: left;
	white-space: nowrap;
	tab-index: auto;
	nav: auto;
	pointer-events: auto;
	transition: background-color color 0.15s cubic-out;
}
button.row:hover,
button.row:focus-visible {
	color: #9ceee8;
	background-color: #12363a;
}
</style>
</head>
<body>
<div id="stage">
	<div id="dim"></div>
	<div id="card">
		<h1>PAUSED</h1>
		<div class="hint">Fly cam   WASD move   Q/Space up   Z/Ctrl down   Shift sprint   mouse look</div>
		<div class="hint quiet">O step    F3 resume</div>
		<button id="resume" class="row" data-id="resume">RESUME</button>
		<button id="step" class="row" data-id="step">STEP</button>
	</div>
</div>
</body>
</rml>
