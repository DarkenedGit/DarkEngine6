{
  "version": 1,
  "type": "editor",
  "note": "Editor commands. Player move, look, and combat stay in entities/player.entity.input.json, which loads after this file. mod is ctrl, shift, or alt: that row counts only while the modifier is held. A row with no mod counts either way. Right-mouse look, middle-mouse pan, wheel zoom, left-click picking, and the Shift camera boost stay in code.",
  "bindings": [
    { "action": "quit", "key": "Escape" },
    { "action": "quit", "button": "Back" },
    { "action": "place", "key": "P" },
    { "action": "place", "button": "X" },
    { "action": "delete", "key": "Delete" },
    { "action": "delete", "key": "Backspace" },
    { "action": "delete", "button": "B" },
    { "action": "toggle_grid", "key": "G" },
    { "action": "toggle_solid", "key": "F" },
    { "action": "toggle_snap", "key": "Tab" },
    { "action": "select_next", "key": "RightBracket" },
    { "action": "select_prev", "key": "LeftBracket" },
    { "action": "type_cube", "key": "Digit1" },
    { "action": "type_sphere", "key": "Digit2" },
    { "action": "type_particle", "key": "Digit3" },
    { "action": "type_point_light", "key": "Digit4" },
    { "action": "type_spot_light", "key": "Digit5" },
    { "action": "type_player", "key": "Digit6" },
    { "action": "type_hunter", "key": "Digit7" },
    { "action": "type_wolf", "key": "Digit8" },
    { "action": "play", "key": "F12" },
    { "action": "cycle_type", "key": "T" },
    { "action": "cycle_color", "key": "C" },
    { "action": "toggle_particle_ui", "key": "F2" },
    { "action": "toggle_anim_ui", "key": "F4" },
    { "action": "toggle_hsm_ui", "key": "F8" },
    { "action": "toggle_assets_ui", "key": "F10" },
    { "action": "debug_fill", "key": "F1" },
    { "action": "debug_lighting", "key": "F6" },
    { "action": "debug_shadow_enable", "key": "F7" },
    { "action": "toggle_scene_mode", "key": "F3" },
    { "action": "debug_gbuffer", "key": "F11" },

    { "action": "move_y", "key": "E", "scale": 1 },
    { "action": "move_y", "key": "Q", "scale": -1 },
    { "action": "move_y", "axis": "RightTrigger", "scale": 1 },
    { "action": "move_y", "axis": "LeftTrigger", "scale": -1 },

    { "action": "save_scene", "key": "F5" },
    { "action": "save_scene", "key": "S", "mod": "ctrl" },
    { "action": "load_scene", "key": "F9" },
    { "action": "load_scene", "key": "O", "mod": "ctrl" },
    { "action": "quick_save", "key": "F5", "mod": "shift" },
    { "action": "quick_load", "key": "F9", "mod": "shift" }
  ]
}
