# Script mode: compile HLSL entries with dxc and write them as C++ byte arrays (plan D10, §3.15.1).
# Used for the LoadingScreen splash, which must start without content/ or a runtime compiler.
#
#   cmake -DDXC=<dxc> -DSRC=<file.hlsl> -DOUT=<header.h> -DSM=6_0 -DNAMESPACE=LoadingScreenShaders
#         "-DENTRIES=VSMain:vs;PSMain:ps" -P cmake/EmbedShaders.cmake
#
# Each entry becomes `inline constexpr unsigned char k<Entry>[]` in namespace Dark::<NAMESPACE>.
# The header is only rewritten when its bytes change.

foreach(_var DXC SRC OUT SM NAMESPACE ENTRIES)
    if(NOT DEFINED ${_var} OR "${${_var}}" STREQUAL "")
        message(FATAL_ERROR "EmbedShaders.cmake requires -D${_var}=")
    endif()
endforeach()

get_filename_component(_src_name "${SRC}" NAME)
get_filename_component(_src_dir "${SRC}" DIRECTORY)
get_filename_component(_out_dir "${OUT}" DIRECTORY)
file(MAKE_DIRECTORY "${_out_dir}")
set(_tmp "${OUT}.dxil.tmp")

set(_text "// Generated by cmake/EmbedShaders.cmake from content/shaders/${_src_name} (DXC, SM ${SM}). Do not edit.\n")
string(APPEND _text "#pragma once\n\nnamespace Dark::${NAMESPACE}\n{\n")

foreach(_pair IN LISTS ENTRIES)
    string(REPLACE ":" ";" _parts "${_pair}")
    list(GET _parts 0 _entry)
    list(GET _parts 1 _stage)
    execute_process(
        COMMAND "${DXC}" -nologo -T "${_stage}_${SM}" -E "${_entry}" -HV 2021 -Ges -O3 -Qstrip_debug -Qstrip_reflect
                -I "${_src_dir}" -Fo "${_tmp}" "${SRC}"
        RESULT_VARIABLE _rc
        OUTPUT_VARIABLE _out
        ERROR_VARIABLE _err
    )
    if(NOT _rc EQUAL 0)
        file(REMOVE "${_tmp}")
        message(FATAL_ERROR "EmbedShaders: dxc failed for ${_src_name} ${_entry} (${_stage}_${SM}):\n${_out}${_err}")
    endif()
    file(READ "${_tmp}" _hex HEX)
    file(REMOVE "${_tmp}")
    string(LENGTH "${_hex}" _hex_len)
    math(EXPR _bytes "${_hex_len} / 2")
    # 0xAB, per byte; 16 per line.
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _arr "${_hex}")
    string(REPEAT "0x[0-9a-f][0-9a-f]," 16 _row)
    string(REGEX REPLACE "(${_row})" "\\1\n        " _arr "${_arr}")
    string(STRIP "${_arr}" _arr)
    string(APPEND _text "    // ${_entry} (${_stage}_${SM}), ${_bytes} bytes.\n")
    string(APPEND _text "    inline constexpr unsigned char k${_entry}[] = {\n        ${_arr}\n    };\n\n")
endforeach()

string(APPEND _text "} // namespace Dark::${NAMESPACE}\n")

set(_old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" _old)
endif()
if(NOT _old STREQUAL _text)
    file(WRITE "${OUT}" "${_text}")
endif()
